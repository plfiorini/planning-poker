# Copy to .env.local for local development. In CI, set these as GitHub Actions variables/secrets.
# Everything here ends up in the public JavaScript bundle: none of it is truly secret.

# Namespace for peer discovery. Set something unique (e.g. "acme-planning-poker") so your rooms
# never share signaling topics with other deployments.
VITE_APP_ID=

# Comma-separated Nostr relays for signaling. Leave empty to use Trystero's built-in list.
VITE_NOSTR_RELAYS=

# Optional TURN relay for people behind strict NATs, corporate VPNs or firewalls that block WebRTC.
# Example with a free Metered account (https://www.metered.ca/tools/openrelay/):
# VITE_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
